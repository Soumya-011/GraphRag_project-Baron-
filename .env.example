# =====================================================================
#  GraphRAG: every setting in one place.
#  Copy to .env, fill the REQUIRED lines. A blank value = the built-in default.
#  Restart uvicorn after any change.  Never commit .env.
# =====================================================================

# ---------- REQUIRED ----------
GEMINI_API_KEY=                 # default key for every task. Free key: https://aistudio.google.com/apikey
NEO4J_PASSWORD=                 # must match docker-compose.yml

# ---------- App ----------
# Name and tagline shown on every page (user page, login, developer page). Change them here only.
APP_NAME=Threadline
APP_TAGLINE=Follow the thread across all your documents.
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# ---------- Developer page (used by the next UI step) ----------
# The developer page (/dev) and every debug endpoint (/metrics, /graph/*, /route, document admin)
# are locked behind this password. Leave DEV_PASSWORD empty ONLY on your own laptop.
DEV_PASSWORD=
DEV_SESSION_SECRET=             # long random string (python -c "import secrets;print(secrets.token_hex(32))")
DEV_SESSION_HOURS=8             # how long a login stays valid
DEV_MAX_LOGIN_ATTEMPTS=5        # failed logins per minute per IP before a short lockout

# ---------- Public user page limits (used by the next UI step) ----------
MAX_UPLOAD_MB=5                 # per file
MAX_FILES_PER_UPLOAD=5
UPLOAD_RATE_PER_HOUR=10         # uploads per IP per hour (each graph extraction spends free-tier quota)
ASK_RATE_PER_MINUTE=20          # questions per IP per minute
SKIP_ALREADY_INGESTED=true      # same file content is never ingested twice

# ---------- LLM: Gemini only ----------
# Free-tier quotas are PER MODEL. Spread the tasks over models to get more total quota.
GEMINI_MODEL=gemini-2.5-flash           # default for any task whose own line below is blank
ANSWER_MODEL=                           # final answers (vector / graph / hybrid). Blank = GEMINI_MODEL
EXTRACTION_MODEL=                       # graph extraction while ingesting. Blank = GEMINI_MODEL
ROUTER_MODEL=gemini-2.5-flash-lite      # only called when the router rules cannot decide
FALLBACK_MODEL=gemini-2.5-flash-lite    # used when the main model hits 429 / returns nothing. Blank = off
# ---- Optional: a different Google account (key) per task ----
# Free-tier quota is counted PER Google project, so a key from another account has its own, separate quota.
# Blank = use GEMINI_API_KEY. Create each key in aistudio.google.com while signed in to that account.
ANSWER_API_KEY=                         # final answers
EXTRACTION_API_KEY=                     # graph extraction (the heaviest user of quota)
ROUTER_API_KEY=                         # the small router call
FALLBACK_API_KEY=                       # used only by the fallback model. With FALLBACK_MODEL blank, the SAME model is retried on this account
GEMINI_RPM=9                            # client-side calls per minute per model (free tier ~10 flash / ~15 lite). 0 = no limiter
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=384                      # answer length; Gemini "thinking" shares it, so the code multiplies it (x3, min 1536)
LLM_TIMEOUT_SECONDS=60                  # raise to 240 if you see timeouts on the 3-hop graph context
EXTRACTION_MAX_TOKENS=768
LLM_MAX_RETRIES=1                       # client-side retries per call before the fallback model takes over
LLM_TOKEN_MULTIPLIER=3                  # Gemini "thinking" tokens share the cap: output cap = LLM_MAX_TOKENS x this ...
LLM_MIN_OUTPUT_TOKENS=1536              # ... but never below this

# ---------- Embeddings (local CPU, ~100 MB RAM) ----------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
# If you change the embedding model: delete data/chroma and re-run `python -m app.ingest`.

# ---------- Vector DB ----------
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=documents

# ---------- Graph DB: local Docker ----------
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
# Showcase option, Neo4j AuraDB Free (no local RAM):
# NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=<password from the Aura credentials file>

# ---------- Chunking / retrieval ----------
# Code defaults are 500 / 50. The old example said 800 / 100: if your .env still has that, your
# evaluation ran with 800. Keep the same value you evaluated with and note it in the README.
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_VECTOR=4                  # chunks per vector question
GRAPH_MAX_HOPS=3                # 1-3. 3 is needed for "alumni -> company -> investor" questions
GRAPH_MAX_EDGES=80              # edges kept from the neighbourhood (nearest first)
MAX_CONTEXT_TOKENS=4000         # context budget for graph / hybrid prompts (about 4 chars per token)

# ---------- Guardrails ----------
MAX_QUESTION_CHARS=500
MIN_RELEVANCE=0.25              # vector similarity below this = "not found" without an LLM call
OFF_TOPIC_ENABLED=true
OFF_TOPIC_THRESHOLD=0.55
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.92 # semantic cache; 1.0 = exact matches only
CACHE_SCAN_LIMIT=300
CACHE_DB_PATH=./data/cache.sqlite
ENABLE_GROUNDING_CHECK=true
ENTITY_FUZZY_THRESHOLD=88       # spelling tolerance when linking names in questions (0-100)

# ---------- Graph: extra node types (Year, ...) ----------
# Comma separated. Each type gets a relation rule generated automatically (IN_YEAR: Person|Company|Location -> Year),
# so a question such as "What events happened in 2010?" can be answered. Fine-tune a type in config.yaml
# (extra_node_types). Leave blank to keep the graph exactly as it is now.
# After changing this, re-extract the graph:   python -m app.ingest --graph-only --force
EXTRA_NODE_TYPES=
EXTRA_NODE_HOPS=1               # hops walked from a Year-like node. 1 = only the events tied to it (recommended)

# ---------- Start-up ----------
WARMUP_ON_START=true            # load models in the background right after the server starts (first answer is fast)

# ---------- Limits that used to be fixed in code ----------
LINK_MAX_ENTITIES=3             # entities taken from one question for the graph search
GRAPH_PATH_MAX_LEN=5            # longest connection searched between two entities
LIST_LIMIT=100                  # "list all companies" answers
CACHE_MAX_ROWS=2000             # answers kept in the cache
MAX_QUEUED_JOBS=5               # uploads waiting for the single ingest worker

# ---------- Router ----------
ROUTER_USE_LLM_FALLBACK=true    # false = rules only, never spend a router call
DEFAULT_ROUTE=hybrid            # graph | vector | hybrid: used when the router call fails

# ---------- LangChain tracing (optional) ----------
LANGSMITH_TRACING=false
